i64 origin(argc: i64, argv: str{}) [
    u128 fact = 1|
    u128 i = 1|
    u8 max = 34|

    as (i max <) [
        u128 i = i 1 +|
        u128 fact = fact i *|
    ]|

    print("Factorial of 34:")|
    print(fact)|
    0 return|
]|

./
